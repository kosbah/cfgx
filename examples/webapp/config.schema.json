{
  "$comment": "Generated by cfgx. Do not edit manually.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "app-name": {
      "default": "webapp",
      "description": "Human-readable application name",
      "type": "string",
      "x-env": "APP_NAME"
    },
    "db": {
      "description": "Database connection settings",
      "properties": {
        "host": {
          "default": "localhost",
          "description": "Database host",
          "type": "string",
          "x-env": "DB_HOST"
        },
        "name": {
          "description": "Database name",
          "type": "string",
          "x-env": "DB_NAME"
        },
        "password": {
          "description": "Database password",
          "type": "string",
          "writeOnly": true,
          "x-env": "DB_PASSWORD"
        },
        "port": {
          "default": 5432,
          "description": "Database port",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer",
          "x-env": "DB_PORT"
        },
        "user": {
          "default": "postgres",
          "description": "Database user",
          "type": "string",
          "x-env": "DB_USER"
        }
      },
      "required": [
        "name",
        "password"
      ],
      "type": "object"
    },
    "debug": {
      "default": false,
      "description": "Enable debug logging; hot-reloadable via APP_DEBUG",
      "type": "boolean",
      "x-env": "APP_DEBUG",
      "x-flag": "--debug"
    },
    "email-enabled": {
      "default": false,
      "description": "Send notification emails",
      "type": "boolean",
      "x-env": "EMAIL_ENABLED",
      "x-flag": "--email-enabled"
    },
    "json-output": {
      "description": "Print machine-readable JSON output",
      "type": "boolean",
      "x-env": "APP_JSON_OUTPUT",
      "x-flag": "--json-output"
    },
    "log-file": {
      "deprecated": true,
      "description": "File to write logs to (DEPRECATED: logs go to stderr; redirect them instead)",
      "type": "string",
      "x-env": "APP_LOG_FILE"
    },
    "output-format": {
      "default": "text",
      "description": "Output format",
      "enum": [
        "text",
        "json"
      ],
      "type": "string",
      "x-env": "APP_OUTPUT_FORMAT",
      "x-flag": "--output-format"
    },
    "port": {
      "default": 8080,
      "description": "HTTP port the server listens on",
      "maximum": 65535,
      "minimum": 1024,
      "type": "integer",
      "x-env": "APP_PORT",
      "x-flag": "--port"
    },
    "smtp": {
      "description": "Outgoing mail settings",
      "properties": {
        "host": {
          "default": "localhost",
          "description": "SMTP server host",
          "type": "string",
          "x-env": "SMTP_HOST"
        },
        "password": {
          "description": "SMTP password",
          "type": "string",
          "writeOnly": true,
          "x-env": "SMTP_PASSWORD"
        },
        "port": {
          "default": 587,
          "description": "SMTP server port",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer",
          "x-env": "SMTP_PORT"
        },
        "user": {
          "description": "SMTP user",
          "type": "string",
          "x-env": "SMTP_USER"
        }
      },
      "required": [
        "password",
        "user"
      ],
      "type": "object"
    },
    "text-output": {
      "description": "Print human-readable text output",
      "type": "boolean",
      "x-env": "APP_TEXT_OUTPUT",
      "x-flag": "--text-output"
    },
    "tls-cert-path": {
      "description": "Path to the TLS certificate (required when tls-enabled=true)",
      "type": "string",
      "x-env": "APP_TLS_CERT",
      "x-flag": "--tls-cert"
    },
    "tls-enabled": {
      "default": false,
      "description": "Enable TLS",
      "type": "boolean",
      "x-env": "APP_TLS_ENABLED",
      "x-flag": "--tls-enabled"
    }
  },
  "required": [
    "tls-cert-path"
  ],
  "type": "object"
}
