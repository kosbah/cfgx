# ── General ───────────────────────────────────────────────────────────
# Human-readable application name
APP_NAME=webapp

# Enable debug logging; hot-reloadable via APP_DEBUG
APP_DEBUG=false

# Print machine-readable JSON output
APP_JSON_OUTPUT=

# Output format
APP_OUTPUT_FORMAT=text

# Print human-readable text output
APP_TEXT_OUTPUT=

# ── Server ────────────────────────────────────────────────────────────
# HTTP port the server listens on
APP_PORT=8080

# Path to the TLS certificate (required when tls-enabled=true)
# REQUIRED
APP_TLS_CERT=

# Enable TLS
APP_TLS_ENABLED=false

# ── Database ──────────────────────────────────────────────────────────
# Database host
DB_HOST=localhost

# Database name
# REQUIRED
DB_NAME=

# Database password
# REQUIRED — sensitive, do not commit
DB_PASSWORD=

# Database port
DB_PORT=5432

# Database user
DB_USER=postgres

# ── Email ─────────────────────────────────────────────────────────────
# Send notification emails
EMAIL_ENABLED=false

# SMTP server host
SMTP_HOST=localhost

# SMTP password
# REQUIRED — sensitive, do not commit
SMTP_PASSWORD=

# SMTP server port
SMTP_PORT=587

# SMTP user
# REQUIRED
SMTP_USER=

# ── DEPRECATED ────────────────────────────────────────────────────────
# File to write logs to
## DEPRECATED: logs go to stderr; redirect them instead
# APP_LOG_FILE=
