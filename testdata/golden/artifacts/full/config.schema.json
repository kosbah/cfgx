{
  "$comment": "Generated by cfgx. Do not edit manually.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "admin_email": {
      "format": "email",
      "type": "string",
      "x-env": "ADMIN_EMAIL"
    },
    "db": {
      "description": "Database settings",
      "properties": {
        "ca_file": {
          "type": "string",
          "x-env": "DB_CA_FILE"
        },
        "host": {
          "default": "localhost",
          "type": "string",
          "x-env": "DB_HOST"
        },
        "password": {
          "type": "string",
          "writeOnly": true,
          "x-env": "DB_PASSWORD"
        },
        "pool": {
          "properties": {
            "idle_timeout": {
              "default": "5m0s",
              "pattern": "^-?(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$|^0$",
              "type": "string",
              "x-env": "DB_POOL_IDLE_TIMEOUT"
            },
            "max_open": {
              "default": 10,
              "type": "integer",
              "x-env": "DB_POOL_MAX_OPEN"
            }
          },
          "type": "object"
        },
        "port": {
          "default": 5432,
          "maximum": 65535,
          "minimum": 1,
          "type": "integer",
          "x-env": "DB_PORT"
        },
        "tls": {
          "default": false,
          "type": "boolean",
          "x-env": "DB_TLS"
        }
      },
      "required": [
        "password"
      ],
      "type": "object"
    },
    "grace": {
      "default": "10s",
      "pattern": "^-?(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$|^0$",
      "type": "string",
      "x-env": "GRACE_PERIOD"
    },
    "hosts": {
      "default": [
        "http://a",
        "http://b"
      ],
      "items": {
        "format": "uri",
        "type": "string"
      },
      "type": "array",
      "x-env": "HOSTS",
      "x-flag": "--hosts"
    },
    "json_output": {
      "type": "boolean",
      "x-flag": "--json"
    },
    "legacy_host": {
      "deprecated": true,
      "description": "DEPRECATED: use db.host instead",
      "type": "string",
      "x-env": "LEGACY_HOST"
    },
    "log_format": {
      "default": "text",
      "enum": [
        "text",
        "json"
      ],
      "type": "string",
      "x-env": "LOG_FORMAT",
      "x-flag": "--log-format"
    },
    "metrics_port": {
      "default": 9090,
      "maximum": 65535,
      "minimum": 1,
      "type": "integer",
      "x-env": "METRICS_PORT"
    },
    "name": {
      "default": "cfgx",
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string",
      "x-env": "APP_NAME",
      "x-flag": "--name"
    },
    "port": {
      "default": 8080,
      "description": "HTTP port the server listens on",
      "maximum": 65535,
      "minimum": 1024,
      "type": "integer",
      "x-env": "APP_PORT",
      "x-flag": "--port"
    },
    "public_url": {
      "format": "uri",
      "type": "string",
      "x-env": "PUBLIC_URL"
    },
    "report_dir": {
      "type": "string",
      "x-env": "REPORT_DIR"
    },
    "sample_rate": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "type": "number",
      "x-env": "SAMPLE_RATE"
    },
    "signing_key": {
      "contentEncoding": "base64",
      "type": "string",
      "writeOnly": true,
      "x-env": "SIGNING_KEY"
    },
    "text_output": {
      "type": "boolean",
      "x-flag": "--text"
    },
    "timeout": {
      "default": "30s",
      "pattern": "^-?(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$|^0$",
      "type": "string",
      "x-env": "TIMEOUT"
    },
    "token": {
      "type": "string",
      "writeOnly": true
    },
    "version": {
      "pattern": "^v?\\d+\\.\\d+\\.\\d+",
      "type": "string",
      "x-env": "APP_VERSION"
    }
  },
  "required": [
    "signing_key"
  ],
  "type": "object"
}
