# ── Server ────────────────────────────────────────────────────────────
# HTTP port the server listens on
APP_PORT=8080

# ── Database ──────────────────────────────────────────────────────────
DB_CA_FILE=

DB_HOST=localhost

# REQUIRED — sensitive, do not commit
DB_PASSWORD=

DB_POOL_IDLE_TIMEOUT=5m0s

DB_POOL_MAX_OPEN=10

DB_PORT=5432

DB_TLS=false

# ── Other ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=

GRACE_PERIOD=10s

HOSTS="http://a http://b"

# json_output: no env var; use config file

LOG_FORMAT=text

METRICS_PORT=9090

APP_NAME=cfgx

PUBLIC_URL=

REPORT_DIR=

SAMPLE_RATE=0.5

# REQUIRED — sensitive, do not commit
SIGNING_KEY=

# text_output: no env var; use config file

TIMEOUT=30s

# token: no env var; use config file

APP_VERSION=

# ── DEPRECATED ────────────────────────────────────────────────────────
## DEPRECATED: use db.host instead
# LEGACY_HOST=
