{
  "$comment": "Generated by cfgx. Do not edit manually.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "name": {
      "default": "cfgx",
      "type": "string",
      "x-env": "APP_NAME"
    },
    "server": {
      "description": "HTTP server",
      "properties": {
        "host": {
          "default": "0.0.0.0",
          "type": "string",
          "x-env": "SERVER_HOST"
        },
        "load_factor": {
          "default": 1,
          "type": "number"
        },
        "origins": {
          "default": [
            "a",
            "b"
          ],
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-env": "SERVER_ORIGINS"
        },
        "timeout": {
          "default": "30s",
          "pattern": "^-?(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$|^0$",
          "type": "string",
          "x-env": "SERVER_TIMEOUT"
        },
        "tls": {
          "description": "TLS settings",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean",
              "x-env": "SERVER_TLS_ENABLED"
            },
            "files": {
              "description": "Certificate files",
              "properties": {
                "cert": {
                  "type": "string",
                  "x-env": "SERVER_TLS_CERT"
                },
                "key": {
                  "type": "string",
                  "writeOnly": true,
                  "x-env": "SERVER_TLS_KEY"
                }
              },
              "type": "object"
            },
            "min_version": {
              "default": 12,
              "type": "integer",
              "x-env": "SERVER_TLS_MIN_VERSION"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
